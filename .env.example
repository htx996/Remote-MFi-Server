# 对外监听端口；xcertplay 使用 http://NAS_IP:8765
REMOTE_MFI_PORT=8765

# 生产环境保持 true，并替换为至少 32 字节的随机值。
MFI_AUTH_REQUIRED=true
MFI_BEARER_TOKEN=

# 镜像内置的真实 CH341F/MFI337 硬件后端。容器会把 operation 追加为最后一个参数。
MFI_BACKEND_COMMAND=/usr/local/bin/mfi-backend
# 如需改用管理员自备后端，显式覆盖为：
# MFI_BACKEND_COMMAND=/opt/remote-mfi/backend/mfi-backend
MFI_BACKEND_TIMEOUT_SECONDS=8

# 内置硬件后端参数；默认匹配本项目支持的 CH341F + MFI337S3959 板。
CH341_USB_VID=0x1a86
CH341_USB_PID=0x5512
MFI_I2C_ADDRESS=0x11
CH341_I2C_SPEED_KHZ=100

# 可选：直接从文件提供证书。若留空，则调用后端的 certificate 操作。
# 文件内容必须是 xcertplay 期望的原始证书字节，而不是 Base64 文本。
# MFI_CERTIFICATE_FILE=/run/secrets/remote-mfi/certificate.bin

# 可选：与 MFI_CERTIFICATE_FILE 二选一。长 Base64 更推荐改用文件。
# MFI_CERTIFICATE_BASE64=

# 必须与真实芯片/证书一致。普通 MFi 使用 mfi；BAA 使用 baa。
MFI_CERTIFICATE_TYPE=mfi
MFI_PROTOCOL_MAJOR=3

# xcertplay 超时重试时会复用 requestId。
IDEMPOTENCY_TTL_SECONDS=300
IDEMPOTENCY_MAX_ENTRIES=1024

# 在 JSON 解析和 Bearer 鉴权前执行的请求体硬上限。
MAX_REQUEST_BODY_BYTES=4096

LOG_LEVEL=INFO

# 仅在启用 docker-compose.usb.yml 时使用。必须先在 FNOS 上查出实际值。
# 路径格式示例：/dev/bus/usb/001/004。必须替换为空机上实际节点。
CH341_DEVICE_PATH=
# 执行 stat -c '%g' "$CH341_DEVICE_PATH" 获取数字 GID。
CH341_DEVICE_GID=
